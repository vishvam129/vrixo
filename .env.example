# ============================================
# Vrixo — Environment Variables Template
# ============================================
# Copy this to .env (which is gitignored) and fill in real values.
#
#   cp .env.example .env
#

# ----- App -----
APP_NAME=Vrixo
APP_ENV=development                 # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-random-64-chars
APP_BASE_URL=http://localhost:8501

# ----- Database (Supabase / Postgres) -----
DATABASE_URL=postgresql://user:pass@localhost:5432/vrixo
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----- Storage (Cloudflare R2) -----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=vrixo-uploads
R2_PUBLIC_URL=https://cdn.vrixo.com

# ----- Redis (Upstash / local) -----
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=https://your-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ----- AI Model Cache -----
HF_HOME=./models_cache
TORCH_HOME=./models_cache/torch
REMBG_HOME=./models_cache/rembg

# ----- Payments -----
RAZORPAY_KEY_ID=rzp_test_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ----- Email (Resend / Mailgun) -----
RESEND_API_KEY=re_your-resend-key
EMAIL_FROM=noreply@vrixo.com

# ----- Auth (JWT) -----
JWT_SECRET=change-me-to-random-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ----- OAuth Providers -----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id

# ----- Monitoring -----
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
POSTHOG_API_KEY=phc_your-posthog-key
POSTHOG_HOST=https://app.posthog.com

# ----- Rate Limiting -----
FREE_TIER_DAILY_LIMIT=5
PRO_TIER_DAILY_LIMIT=1000
RATE_LIMIT_WINDOW_SECONDS=86400

# ----- File Uploads -----
MAX_UPLOAD_SIZE_MB=10
UPLOAD_RETENTION_HOURS=24
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,heic

# ----- Watermark -----
WATERMARK_TEXT=Edited with Vrixo
WATERMARK_OPACITY=0.5
WATERMARK_POSITION=bottom-right
